  "devDependencies": {
    "@rsbuild/core": "^1.4.15",
    "@rsbuild/plugin-react": "^1.3.4",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "openapi-typescript": "^7.9.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.11.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@9.15.0"
